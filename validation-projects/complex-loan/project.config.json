{
  "project": {
    "id": "complex-loan-validation",
    "name": "复杂贷款多系统验证"
  },

  "startup": {
    "database": ".data/knowledge.db",
    "port": 8083
  },

  "repositoryRoot": ".data/repositories",

  "knowledge": {
    "businessContextRoot": "knowledge/business-context",
    "baselineRoot": "knowledge/baseline",
    "codeMapRoot": ".data/knowledge/generated-code-map"
  },

  "requirementsRoot": "requirements",

  "systems": [
    {
      "id": "fineract-platform",
      "name": "Fineract 开源贷款平台"
    },
    {
      "id": "channel-system",
      "name": "渠道系统"
    },
    {
      "id": "middle-system",
      "name": "贷款中台系统"
    },
    {
      "id": "simulator-system",
      "name": "外部模拟系统"
    }
  ],

  "repositories": [
    {
      "id": "fineract-repo",
      "gitUrl": "unused",
      "localPath": "repos/fineract"
    },
    {
      "id": "mifos-web-repo",
      "gitUrl": "unused",
      "localPath": "repos/mifos-web"
    },
    {
      "id": "channel-service-repo",
      "gitUrl": "unused",
      "localPath": "repos/loan-channel-service"
    },
    {
      "id": "loan-middle-repo",
      "gitUrl": "unused",
      "localPath": "repos/loan-middle"
    },
    {
      "id": "external-simulator-repo",
      "gitUrl": "unused",
      "localPath": "repos/loan-external-simulator"
    }
  ],

  "applications": [
    {
      "id": "fineract-backend",
      "name": "Fineract 贷款中台服务",
      "systemId": "fineract-platform",
      "repositoryId": "fineract-repo",
      "sourceRoot": ".",
      "type": "BACKEND",
      "language": "java",
      "framework": "spring-boot"
    },
    {
      "id": "mifos-web",
      "name": "Mifos X 平台 Web 前端",
      "systemId": "fineract-platform",
      "repositoryId": "mifos-web-repo",
      "sourceRoot": ".",
      "type": "FRONTEND",
      "language": "typescript",
      "framework": "angular"
    },
    {
      "id": "channel-service",
      "name": "融商贷渠道后端",
      "systemId": "channel-system",
      "repositoryId": "channel-service-repo",
      "sourceRoot": ".",
      "type": "BACKEND",
      "language": "java",
      "framework": "spring-boot"
    },
    {
      "id": "loan-middle",
      "name": "融商贷贷款中台",
      "systemId": "middle-system",
      "repositoryId": "loan-middle-repo",
      "sourceRoot": ".",
      "type": "BACKEND",
      "language": "java",
      "framework": "spring-boot"
    },
    {
      "id": "external-simulator",
      "name": "外部系统模拟服务",
      "systemId": "simulator-system",
      "repositoryId": "external-simulator-repo",
      "sourceRoot": ".",
      "type": "BACKEND",
      "language": "java",
      "framework": "spring-boot"
    }
  ]
}
