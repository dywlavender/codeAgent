# Copy this file to .env and replace the placeholders.
# .env is loaded automatically by the Python CLI and is ignored by Git.

# Claude Code is used by both query/assessment and business knowledge structuring.
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_TIMEOUT=600
CLAUDE_CODE_READ_TOOLS=Read,Glob,Grep

# The example project.config.json enables administrator authentication with this name.
BUSINESS_CODE_ADMIN_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# BUSINESS_CODE_LOG_LEVEL=INFO
