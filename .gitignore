.venv/
.venv-windows/
.venv-offline/
.data/
frontend/node_modules/
frontend/dist/
__pycache__/
*.py[cod]
*.db
.DS_Store
.env
.env.local
.env.*.local
!.env.example

# Build artifacts
*.egg-info/
build/
dist/
offline-packages/*.zip

# IDE / tooling
.idea/
.jbeval/
.vscode/
examples/validation-project/

# Cloned validation source snapshots are re-creatable from
# validation-projects/*/VERSIONS.md; keep them out of this repository.
validation-projects/**/repos/
validation-projects/**/.data/

# Local runtime config (copy from project.config.example.json)
project.config.json
# Project configs inside validation projects are committed assets, not local state.
!validation-projects/**/project.config.json

# Committed demo/test configurations are fixtures, not local runtime state.
!examples/demo/project.config.json
!tests/fixtures/**/project.config.json

.workbuddy/
.playwright-cli/
output/playwright/
.pi/
.workbuddy-ai/
wf-data-snapshot-*

# AOCI agent host integration (machine-bound; do not commit)
.codex/config.toml
.codex/config.toml.backup.*

# Local scratch / tool state / offline artifacts (not source work products)
.tmp-incr/
.zcode/
pi-offline/
AGENTS.md.backup.*

# Platform repo's own AOCI scaffolding is unbuilt and machine-bound; the
# versioned demo cognition lives under examples/*/.
/.aoci/
/aoci.txt
/aoci.meta.txt
/aoci.code.txt
