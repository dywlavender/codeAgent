# Copy this file to .env and replace the placeholders.
# .env is loaded automatically by the Python CLI and is ignored by Git.

# 主问答默认使用 Pi Agent（RPC 子进程，唯一在线调查循环）。
BUSINESS_CODE_AGENT_RUNTIME=pi
# Pi 可执行文件、模型与超时；模型留空时使用 Pi 自身配置，实际模型记录在 Trace。
BUSINESS_CODE_PI_COMMAND=pi
# BUSINESS_CODE_PI_MODEL=
# BUSINESS_CODE_PI_TIMEOUT=600
# BUSINESS_CODE_PI_THINKING=
# LangChain 仅保留为显式历史对照（同题评测/历史回看），不参与默认链路，Pi 失败不回退：
# BUSINESS_CODE_AGENT_RUNTIME=langchain

# 以下模型连接供 Direct 与 LangChain 历史对照使用；Pi 使用自身模型配置。
BUSINESS_CODE_MODEL_ENABLED=true
BUSINESS_CODE_MODEL_PROVIDER=openai
BUSINESS_CODE_MODEL_BASE_URL=https://your-service/compatible-mode/v1
BUSINESS_CODE_MODEL_NAME=your-model
BUSINESS_CODE_MODEL_API_KEY=
BUSINESS_CODE_MODEL_TEMPERATURE=0.2
BUSINESS_CODE_MODEL_TIMEOUT=120
# 主问答不设调查轮数和总时长上限；有界评测通过脚本参数显式指定。
BUSINESS_CODE_AGENT_CONTEXT_CHARS=64000
# Direct 上下文实验的输入、工具定义和输出合计 token 预算。留空时按字符裁剪。
# BUSINESS_CODE_AGENT_CONTEXT_TOKENS=40960
# 以下 WORKFLOW／RETRIEVAL／ANSWER_MODE／CONTRACTS 仅在显式 RUNTIME=langchain 时生效。
# auto 只复用已准备的索引；files 为文件工具对照，hybrid 为显式混合检索。
BUSINESS_CODE_AGENT_RETRIEVAL=auto
BUSINESS_CODE_AGENT_ANSWER_MODE=plain
# 默认 plain；facts 为实验性事实分层与程序核对，真实复验尚未通过默认启用验收。
BUSINESS_CODE_AGENT_CONTRACTS=auto
# auto 只复用已有 contract-index；off 用于对照，on 显式要求索引；不自动建索引。
# ANSWER_MODE=contracts 为实验性收尾：程序生成字段与映射，模型引用分支解释业务，程序约束改动前提。
# 状态／区分等问题按需补查已准备的成员写入点，不代表完整状态机；contracts 收尾仍用于实验对照。
BUSINESS_CODE_AGENT_WORKFLOW=coordinated
# coordinated 按目标与检索结果安排检索、契约核对和补读；basic/tracked 保留用于对照。
# 仅对支持此参数的模型启用，测试时需记录其值。
# BUSINESS_CODE_MODEL_ENABLE_THINKING=false

# Direct 答案覆盖实验需配合 core-v1 或 core-business-v1。
# BUSINESS_CODE_AGENT_ANSWER_CLOSURE_ENABLED=true

# Historical evaluations and knowledge structuring may still use Claude CLI.
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_TIMEOUT=600
CLAUDE_CODE_READ_TOOLS=Read,Glob,Grep

# The example project.config.json enables administrator authentication with this name.
BUSINESS_CODE_ADMIN_TOKEN=

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）
# BUSINESS_CODE_LOG_LEVEL=INFO
