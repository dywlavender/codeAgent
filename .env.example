# Copy this file to .env and replace the placeholders.
# .env is loaded automatically by the Python CLI and is ignored by Git.

# Shared LangChain model configuration for Knowledge Update Agent and Query Agent.
BUSINESS_CODE_MODEL_ENABLED=true
BUSINESS_CODE_MODEL_PROVIDER=openai
BUSINESS_CODE_MODEL_NAME=gpt-4.1-mini
BUSINESS_CODE_MODEL_API_KEY=
BUSINESS_CODE_MODEL_BASE_URL=
BUSINESS_CODE_MODEL_TEMPERATURE=0
BUSINESS_CODE_MODEL_TIMEOUT=60
BUSINESS_CODE_MODEL_MAX_RETRIES=2

# The example project.config.json enables administrator authentication with this name.
BUSINESS_CODE_ADMIN_TOKEN=
